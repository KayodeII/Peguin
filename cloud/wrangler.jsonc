{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "penguin",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The website (../web) is served from the same Worker and origin as the API.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/app/*", "/webhooks/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "penguin", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }
  ],
  "vars": {
    "APP_ORIGIN": "http://localhost:8787",
    "CLAUDE_MODEL": "claude-opus-5",
    "TRIAL_DAYS": "14",
    "DRAFTS_PER_DAY": "20",
    "ANSWERS_PER_DAY": "200"
  }
  // Secrets (wrangler secret put, or .dev.vars locally): ANTHROPIC_API_KEY, STRIPE_SECRET_KEY,
  // STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_ID, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
  // RESEND_API_KEY, EMAIL_FROM, LICENSE_PRIVATE_JWK
}
