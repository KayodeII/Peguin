{
  "name": "penguin-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "Penguin accounts, billing, licences and server-side Claude (Cloudflare Worker + D1).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply penguin --local",
    "db:migrate": "wrangler d1 migrations apply penguin --remote",
    "keys:license": "node scripts/license-keys.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.148.0"
  }
}
