# ---- Infrastructure (docker compose provides these locally)
DATABASE_URL=postgres://penguin:penguin@localhost:5432/penguin
REDIS_URL=redis://localhost:6379

# ---- Public URLs the meeting-bot provider can reach (ngrok in development)
API_PUBLIC_URL=https://your-api.ngrok.app
REALTIME_PUBLIC_URL=https://your-realtime.ngrok.app

# ---- Secrets: generate each with `openssl rand -base64 32`
ADMIN_API_KEY=
SESSION_SECRET=
WEBHOOK_SECRET=
ENCRYPTION_KEY=

# ---- Meeting bots: recall (managed) or attendee (self-hosted or attendee.dev)
BOT_PROVIDER=recall
RECALL_API_KEY=
RECALL_REGION=us-west-2
# ATTENDEE_API_KEY=
# ATTENDEE_BASE_URL=https://app.attendee.dev/api/v1

# ---- AI and speech
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
DEEPGRAM_API_KEY=

# ---- Capacity
REALTIME_MAX_SESSIONS=300
WORKER_CONCURRENCY=20
